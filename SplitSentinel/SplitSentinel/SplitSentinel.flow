            },
            {
              "field": "decidedAt",
              "value": "=js:new Date().toISOString()"
            },
            {
              "field": "finalOutcome",
              "value": "=js:$vars.finalPrStatus"
            },
            {
              "field": "runLog",
              "value": "=js:$vars.finalize.output.runLog"
            }
          ]
        }
      }
    },
    {
      "id": "notifyNeeded",
      "type": "core.logic.decision",
      "typeVersion": "1.0.0",
      "ui": {
