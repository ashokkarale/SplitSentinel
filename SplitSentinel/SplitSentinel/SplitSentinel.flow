    "variableUpdates": {
      "resolveRun": [
        {
          "variableId": "prId",
          "expression": {
            "type": "jsExpression",
            "expression": "$vars.resolveRun.output.prId",
            "fieldType": "string"
          }
        },
        {
          "variableId": "dryRun",
          "expression": {
            "type": "jsExpression",
            "expression": "$vars.resolveRun.output.dryRun",
            "fieldType": "boolean"
          }
        }
      ],
      "ruleRelease": [
        {
          "variableId": "pathValue",
          "expression": {
            "type": "jsExpression",
            "expression": "\"RULES_RELEASE\"",
            "fieldType": "string"
          }
        },
        {
          "variableId": "finalPrStatus",
          "expression": {
            "type": "jsExpression",
            "expression": "\"Released\"",
            "fieldType": "string"
          }
        }
      ],
      "holdUnverified": [
        {
          "variableId": "pathValue",
          "expression": {
            "type": "jsExpression",
            "expression": "\"UNVERIFIED_HOLD\"",
            "fieldType": "string"
          }
        },
        {
          "variableId": "finalPrStatus",
          "expression": {
            "type": "jsExpression",
            "expression": "\"Unverified\"",
            "fieldType": "string"
          }
        }
      ],
      "check1": [
        {
          "variableId": "agentResult",
          "expression": {
            "type": "jsExpression",
            "expression": "$vars.check1.output",
            "fieldType": "object"
          }
        }
      ],
      "check2": [
        {
          "variableId": "agentResult",
          "expression": {
            "type": "jsExpression",
            "expression": "$vars.check2.output",
            "fieldType": "object"
          }
        }
      ],
      "gateway": [
        {
          "variableId": "pathValue",
          "expression": {
            "type": "jsExpression",
            "expression": "$vars.gateway.output.path",
            "fieldType": "string"
          }
        }
      ],
      "agentRelease": [
        {
          "variableId": "finalPrStatus",
          "expression": {
            "type": "jsExpression",
            "expression": "\"Released\"",
            "fieldType": "string"
          }
        }
      ],
      "requesterConsolidates": [
        {
          "variableId": "finalPrStatus",
          "expression": {
            "type": "jsExpression",
            "expression": "\"Consolidated\"",
            "fieldType": "string"
          }
        },
        {
          "variableId": "humanDecisionValue",
          "expression": {
            "type": "jsExpression",
            "expression": "\"CONSOLIDATE\"",
            "fieldType": "string"
          }
        },
        {
          "variableId": "pathValue",
          "expression": {
            "type": "jsExpression",
            "expression": "\"REQUESTER_CONSOLIDATED\"",
            "fieldType": "string"
          }
        },
        {
          "variableId": "humanComment",
          "expression": {
            "type": "jsExpression",
            "expression": "\"Requester chose to consolidate\"",
            "fieldType": "string"
          }
        }
      ],
      "keepJustification": [
        {
          "variableId": "justification",
          "expression": {
            "type": "jsExpression",
            "expression": "$vars.keepJustification.output",
            "fieldType": "string"
          }
        }
      ],
      "check3": [
        {
          "variableId": "agentResult",
          "expression": {
            "type": "jsExpression",
            "expression": "$vars.check3.output",
            "fieldType": "object"
          }
        }
      ],
      "gateway2": [
        {
          "variableId": "pathValue",
          "expression": {
            "type": "jsExpression",
            "expression": "$vars.gateway2.output.path",
            "fieldType": "string"
          }
        },
        {
          "variableId": "needsReview",
          "expression": {
            "type": "jsExpression",
            "expression": "$vars.gateway2.output.decision !== 'RELEASE'",
            "fieldType": "boolean"
          }
        }
      ],
      "markReview": [
        {
          "variableId": "needsReview",
          "expression": {
            "type": "jsExpression",
            "expression": "true",
            "fieldType": "boolean"
          }
        }
      ],
      "decConsolidate": [
        {
          "variableId": "finalPrStatus",
          "expression": {
            "type": "jsExpression",
            "expression": "\"Consolidated\"",
            "fieldType": "string"
          }
        },
        {
          "variableId": "humanDecisionValue",
          "expression": {
            "type": "jsExpression",
            "expression": "\"CONSOLIDATE\"",
            "fieldType": "string"
