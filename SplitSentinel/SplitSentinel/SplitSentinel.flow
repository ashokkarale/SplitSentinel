    {
      "id": "reviewCard",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Review card",
        "icon": "code"
      },
      "inputs": {
        "script": "\nvar a = $vars.agentResult || {};\nvar rules = $vars.rules.output;\nvar amount = a.combinedAmount || rules.combinedAmount;\nvar tier = a.requiredApprovalTier || rules.combinedTier;\nvar tierRow = (rules.matrix || []).filter(function (t) { return t.tierId === tier; })[0] || {};\nreturn {\n  caseSummary: 'PR ' + $vars.prId + ' (' + rules.requesterName + ') is grouped with ' + (a.relatedPrIds || rules.groupPrIds).join(', ')\n    + '. Combined INR ' + amount + ' needs tier ' + tier + ' approval (' + (tierRow.approverRole || '?') + ')'\n    + (a.competitiveBidRequired ? ' and a competitive bid (RFQ).' : '.'),\n  ruleEvidence: 'Score ' + rules.score + ': ' + JSON.parse(rules.signals).map(function (s) { return s.code + ' ' + (s.points > 0 ? '+' : '') + s.points + ' ' + s.detail; }).join('; '),\n  agentAssessment: (a.verdict || 'NOT_RUN') + ' (' + (a.legitException || 'NONE') + ', confidence ' + (a.confidence || 0) + '): ' + (a.reasoning || '')\n    + (a.corrections ? ' [corrected: ' + a.corrections + ']' : ''),\n  requesterJustification: $vars.justification || 'none',\n  title: 'SplitSentinel: possible split, PR ' + $vars.prId + ' (' + tier + ' approval)'\n};\n"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "properties": {
            "caseSummary": {
              "type": "string"
            },
            "ruleEvidence": {
              "type": "string"
            },
            "agentAssessment": {
              "type": "string"
            },
            "requesterJustification": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
