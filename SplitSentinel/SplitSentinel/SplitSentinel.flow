                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "ab445ad6-ce67-4073-8276-65f5cdc4707e"
    },
    {
      "id": "gateway",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Guardrail",
        "icon": "code"
      },
      "inputs": {
        "script": "\nvar r = $vars.agentResult || {};\nvar score = $vars.rules.output.score;\nif (r.verdict === 'NOT_SPLIT' && r.legitException !== 'NONE' && score < 60) return { decision: 'RELEASE', path: 'AGENT_RELEASE' };\nif (true && r.verdict === 'LIKELY_SPLIT' && r.suggestedAction === 'ASK_REQUESTER') return { decision: 'ASK_REQUESTER', path: 'ASK_REQUESTER' };\nvar guard = r.verdict === 'NOT_SPLIT';\nreturn { decision: 'REVIEW', path: guard ? 'GUARDRAIL_REVIEW' : (r.verdict === 'FAILED' ? 'FAILED_REVIEW' : 'APPROVER_REVIEW') };\n"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "properties": {
            "decision": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "cb77f526-b0fa-4809-8671-50ee75f9916b"
    },
    {
      "id": "decision",
      "type": "core.logic.switch",
      "typeVersion": "1.3",
      "display": {
        "label": "Agent outcome",
        "icon": "between-horizontal-start"
      },
      "inputs": {
        "cases": [
          {
            "id": "case_1",
            "label": "Cleared",
            "expression": "$vars.gateway.output.decision === \"RELEASE\""
          },
          {
            "id": "case_2",
            "label": "Ask requester",
            "expression": "$vars.gateway.output.decision === \"ASK_REQUESTER\""
          }
        ],
        "defaultBranch": {
          "enabled": true,
          "label": "Default"
        }
      },
      "uniqueId": "837f7c88-a66d-4946-a031-5d2cafce4a89"
    },
    {
      "id": "agentRelease",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Agent cleared",
        "icon": "code"
      },
      "inputs": {
        "script": "return \"AGENT_RELEASE\";"
      },
      "outputs": {
        "output": {
          "type": "string",
          "description": "The return value of the script",
