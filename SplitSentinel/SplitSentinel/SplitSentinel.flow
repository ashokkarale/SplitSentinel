      "typeVersion": "1.4",
      "display": {
        "label": "Checked before?",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "Yes: skip",
        "falseLabel": "False",
        "expression": "!$vars.dryRun && ($vars.existingCase.output.results || []).length > 0"
