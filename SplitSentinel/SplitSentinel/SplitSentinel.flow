            "fieldType": "string"
          },
          "var": "output",
          "scope": "external"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": {
            "type": "literal",
            "expression": "=Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "collection": {
          "type": "jsExpression",
          "expression": "$vars.finalize.output.targetRecordIds",
          "fieldType": "array"
        },
        "parallel": false,
        "breakEnabled": false
      }
    },
