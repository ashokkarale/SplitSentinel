        }
      },
      "outputs": {
        "output": {
          "type": "jsonSchema",
          "description": "Entity record queried by this node, or the matching records under \"results\"",
          "source": "=response",
          "var": "output"
        }
      },
      "uniqueId": "6002ca1f-174c-4fc5-a790-2a93cce05c99"
    },
    {
