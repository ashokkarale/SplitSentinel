    {
      "id": "reviewCard",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 6480,
          "y": 600
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Review card",
        "icon": "code"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output",
          "properties": {
            "whatHappened": {
              "type": "string"
            },
            "combined": {
              "type": "string"
            },
            "approval": {
              "type": "string"
            },
            "risk": {
              "type": "string"
            },
            "whyFlagged": {
              "type": "string"
            },
            "aiView": {
              "type": "string"
            },
            "justification": {
              "type": "string"
            },
            "guide": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "script": "\n\nfunction inr(n) {\n  var s = String(Math.round(Number(n) || 0)), last3 = s.slice(-3), rest = s.slice(0, -3);\n  return '₹' + (rest ? rest.replace(/\\B(?=(\\d{2})+(?!\\d))/g, ',') + ',' : '') + last3;\n}\nfunction shortDate(iso) {\n  var m = String(iso || '').match(/^(\\d{4})-(\\d{2})-(\\d{2})/);\n  if (!m) return String(iso || '');\n  return Number(m[3]) + ' ' + ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][Number(m[2]) - 1] + ' ' + m[1];\n}\nfunction roleName(r) {\n  return { LineManager: 'Line Manager', DeptHead: 'Department Head', CFO: 'CFO', CFOCommittee: 'CFO + Procurement Committee' }[r] || r || 'approver';\n}\nfunction listIds(ids) {\n  ids = ids || [];\n  return ids.length < 2 ? ids.join('') : ids.slice(0, -1).join(', ') + ' and ' + ids[ids.length - 1];\n}\n\nvar a = $vars.agentResult || {};\nvar rules = $vars.rules.output;\nvar amount = a.combinedAmount || rules.combinedAmount;\nvar tier = a.requiredApprovalTier || rules.combinedTier;\nvar tierRow = (rules.matrix || []).filter(function (t) { return t.tierId === tier; })[0] || {};\nvar anchorRow = (rules.matrix || []).filter(function (t) { return t.tierId === rules.anchorTier; })[0] || {};\n// RFQ comes from the approval matrix, never from the agent's answer.\nvar rfq = tierRow.rfqRequired === true || String(tierRow.rfqRequired) === 'true';\nvar related = (a.relatedPrIds && a.relatedPrIds.length ? a.relatedPrIds : rules.groupPrIds);\nvar others = related.filter(function (x) { return x !== $vars.prId; });\nvar approval = tier + ' · ' + roleName(tierRow.approverRole) + (rfq ? ' + RFQ' : '');\nvar band = rules.score >= 60 ? 'high' : rules.score >= 30 ? 'medium' : 'low';\nvar verdicts = { SPLIT: 'Split: one purchase broken into several PRs', LIKELY_SPLIT: 'Likely split', NOT_SPLIT: 'Not a split',\n  FAILED: 'No usable AI answer: decide from the rule evidence above' };\nvar signals = JSON.parse(rules.signals || '[]');\nreturn {\n  whatHappened: rules.requesterName + ' (' + rules.requesterCostCenter + ') raised ' + $vars.prId\n    + (others.length ? '. Together with ' + listIds(others) + ' it comes to ' + inr(amount) : ' for ' + inr(amount))\n    + ', which needs ' + roleName(tierRow.approverRole) + ' approval (' + tier + ')' + (rfq ? ' and a competitive bid (RFQ)' : '')\n    + (rules.anchorTier && rules.anchorTier !== tier ? '. On its own, the PR only needed ' + roleName(anchorRow.approverRole) + ' approval (' + rules.anchorTier + ').' : '.'),\n  combined: inr(amount),\n  approval: approval,\n  risk: rules.score + ' / 100 (' + band + ')',\n  whyFlagged: signals.length ? signals.map(function (s) { return (s.points > 0 ? '• ' : '– ') + s.detail + '  (' + (s.points > 0 ? '+' : '') + s.points + ')'; }).join('\\n') : 'No rule signals.',\n  aiView: (verdicts[a.verdict] || 'Not assessed') + (a.verdict && a.verdict !== 'FAILED' ? ', ' + Math.round((Number(a.confidence) || 0) * 100) + '% confident' : '')\n    + (a.legitException && a.legitException !== 'NONE' ? '\\nException claimed: ' + a.legitException.replace(/_/g, ' ').toLowerCase() : '')\n    + '\\n\\n' + (a.reasoning || '') + (a.corrections ? '\\n\\n(Checked against the data and corrected: ' + a.corrections + ')' : ''),\n  justification: $vars.justification || '',\n  guide: 'Merge PRs: one ' + inr(amount) + ' requirement, sent to ' + roleName(tierRow.approverRole) + (rfq ? ' with an RFQ' : '') + '.\\n'\n    + 'Keep separate: release the PRs as raised.\\n'\n    + 'Reject: reject all of them; the requester is told why.\\n'\n    + 'Not a split: release them and log a false alarm.',\n  title: 'Possible split: ' + $vars.prId + ' · ' + inr(amount) + ' needs ' + roleName(tierRow.approverRole)\n};\n"
      }
    },
    {
      "id": "approverReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "ui": {
        "position": {
