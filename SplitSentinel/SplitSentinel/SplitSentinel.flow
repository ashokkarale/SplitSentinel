      "model": {
        "type": "bpmn:InclusiveGateway"
      },
      "inputs": {
        "trueLabel": "Yes: skip",
        "falseLabel": "False",
        "expression": "!$vars.dryRun && ($vars.existingCase.output.results || []).length > 0"
      }
