          "api-function"
        ]
      }
    },
    {
      "nodeType": "core.logic.loop",
      "supportsErrorHandling": true,
      "version": "2.4",
      "category": "control-flow",
      "description": "Iterate over a collection of items",
      "tags": [
        "control-flow",
        "loop",
        "iteration"
      ],
      "sortOrder": 20,
      "display": {
        "label": "Loop",
        "icon": "repeat",
        "shape": "container",
        "description": "Execute a sequence of actions repeatedly for each item in a collection"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "boundary": "outer",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "boundary": "outer",
          "handles": [
            {
              "id": "success",
              "type": "source",
              "handleType": "output"
            },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": {
                "maxConnections": 1
              }
            }
          ]
        },
        {
          "position": "left",
          "boundary": "inner",
          "handles": [
            {
              "id": "start",
              "label": "start",
              "type": "source",
              "handleType": "output"
            }
          ]
        },
        {
          "position": "right",
          "boundary": "inner",
          "handles": [
            {
              "id": "continue",
              "label": "continue",
              "type": "target",
              "handleType": "input"
            },
            {
              "id": "break",
              "label": "break",
              "type": "target",
              "handleType": "input",
              "visible": "inputs.breakEnabled"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:SubProcess"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "array"
          },
          "parallel": {
            "type": "boolean"
          },
          "completionCondition": {
            "type": "string"
          },
          "breakEnabled": {
            "type": "boolean"
          }
        },
        "required": [
          "collection"
        ]
      },
      "inputDefaults": {
        "collection": [],
        "parallel": false,
        "completionCondition": "",
        "breakEnabled": false
      },
      "outputDefinition": {
        "currentItem": {
          "type": "any",
          "description": "The current item being iterated in the loop",
          "source": "=loopContext.currentItem",
          "var": "currentItem",
          "scope": "internal"
        },
        "currentIteration": {
          "type": "number",
          "description": "The current iteration number (1-based)",
          "source": "=loopContext.currentIteration",
          "var": "currentIteration",
          "scope": "internal"
        },
        "collection": {
          "type": "array",
          "description": "The collection being iterated over",
          "source": "=loopContext.collection",
          "var": "collection",
          "scope": "internal"
        },
        "output": {
          "type": "array",
          "description": "Aggregated results from all loop iterations",
          "source": "=loopContext.output",
          "var": "output",
          "scope": "external"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "form": {
        "id": "loop-properties",
        "title": "Loop configuration",
        "sections": [
          {
            "id": "iteration",
            "title": "Iteration",
            "fields": [
              {
                "name": "inputs.collection",
                "type": "custom",
                "component": "code-editor",
                "label": "Collection",
                "description": "The loop runs once for each item in this array or collection.",
                "componentProps": {
                  "singleLine": true,
                  "mode": "expression",
                  "toggleable": false,
                  "placeholder": "$vars.scriptTask1.output",
                  "showVariableButton": true,
                  "language": "javascript",
                  "expectedType": "array",
                  "validationMode": "expression"
                }
              },
              {
                "name": "inputs.parallel",
                "type": "switch",
                "label": "Parallel",
                "description": "The loop runs iterations at the same time."
              },
              {
                "name": "inputs.completionCondition",
                "type": "custom",
                "component": "code-editor",
                "label": "Break on condition",
                "description": "The loop exits early when this condition becomes true after an iteration completes.",
                "componentProps": {
                  "singleLine": true,
                  "mode": "expression",
                  "toggleable": false,
                  "placeholder": "$vars.processedCount >= 5",
                  "showVariableButton": true,
                  "alwaysIncludeSelf": true,
                  "returnType": "boolean",
                  "validationMode": "expression",
                  "language": "javascript"
                }
              },
              {
                "name": "inputs.breakEnabled",
                "type": "switch",
                "label": "Show break handle",
                "description": "Nodes inside the loop can exit through a break handle."
              }
            ]
          }
        ]
      }
    },
    {
      "nodeType": "core.datafabric.update",
      "version": "1.0",
      "category": "data",
      "description": "Update an entity record in Data Fabric",
      "tags": [
        "datafabric",
        "entity",
        "data",
        "update",
        "write"
      ],
      "sortOrder": 36,
      "display": {
        "label": "Update entity",
        "canvasLabel": "Update entity",
        "icon": "layers-arrow-up-right"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:Task",
        "debug": {
          "runtime": "bpmnEngine"
        }
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "entityConfig": {
            "type": "object",
            "properties": {
              "entityName": {
                "type": "string",
                "minLength": 1,
                "errorMessage": "An entity must be selected"
              },
              "recordId": {
                "type": "string"
              },
              "readEntityNodeId": {
                "type": "string"
              },
              "fieldUpdates": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "field"
                  ]
                },
                "errorMessage": "Select a field to update"
              }
            },
            "required": [
              "entityName",
              "fieldUpdates"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "recordSource": {
                      "const": "byId"
                    }
                  },
                  "required": [
                    "recordSource"
                  ]
                },
                "then": {
                  "required": [
                    "recordId"
                  ],
                  "properties": {
                    "recordId": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  },
                  "errorMessage": "A record ID is required"
                }
              },
              {
                "if": {
                  "properties": {
                    "recordSource": {
                      "const": "fromRead"
                    }
                  },
                  "required": [
                    "recordSource"
                  ]
                },
                "then": {
                  "required": [
                    "readEntityNodeId"
                  ],
                  "properties": {
                    "readEntityNodeId": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  },
                  "errorMessage": "A Read entity node must be selected"
                }
              }
            ],
            "errorMessage": {
              "required": {
                "entityName": "An entity must be selected",
                "fieldUpdates": "Select a field to update"
              }
            }
          }
        },
        "required": [
          "entityConfig"
        ]
      },
      "inputDefaults": {
        "entityConfig": {}
      },
      "outputDefinition": {
        "output": {
          "type": "jsonSchema",
          "description": "Entity record after the update",
          "source": "=response",
          "var": "output"
        }
      },
      "form": {
        "id": "update-entity-properties",
        "title": "Update entity configuration",
        "sections": [
          {
            "id": "entity-config",
            "title": "Entity configuration",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.entityConfig",
                "type": "custom",
                "component": "update-entity-config",
                "label": ""
              }
            ]
          }
        ]
      }
    },
    {
      "nodeType": "core.datafabric.create",
      "version": "1.3",
      "category": "data",
      "description": "Create an entity record in Data Fabric",
      "tags": [
        "datafabric",
        "entity",
        "data",
        "create",
        "insert",
        "write"
      ],
      "sortOrder": 37,
      "display": {
        "label": "Create entity record",
