    {
      "id": "retryNeeded",
      "type": "core.logic.decision",
      "typeVersion": "1.4",
      "display": {
        "label": "Invalid?",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "Yes: retry",
        "falseLabel": "False",
        "expression": "!$vars.check1.output.ok"
      },
      "uniqueId": "098b96f4-2d11-47c2-8a3e-a44160c6f306"
