            },
            {
              "field": "agentReasoning",
              "value": "=js:$vars.agentResult.reasoning || ''"
            },
            {
              "field": "requiredApprovalTier",
              "value": "=js:$vars.agentResult.requiredApprovalTier || $vars.rules.output.combinedTier"
            },
            {
              "field": "requesterJustification",
              "value": "=js:$vars.justification"
            },
            {
              "field": "humanDecision",
              "value": "=js:$vars.humanDecisionValue"
            },
            {
              "field": "humanComment",
