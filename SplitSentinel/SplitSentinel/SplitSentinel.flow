    {
      "id": "askCard",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 4800,
          "y": 560
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Draft question",
        "icon": "code"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output",
          "properties": {
            "message": {
              "type": "string"
            },
            "guide": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "script": "\n\nfunction inr(n) {\n  var s = String(Math.round(Number(n) || 0)), last3 = s.slice(-3), rest = s.slice(0, -3);\n  return '₹' + (rest ? rest.replace(/\\B(?=(\\d{2})+(?!\\d))/g, ',') + ',' : '') + last3;\n}\nfunction shortDate(iso) {\n  var m = String(iso || '').match(/^(\\d{4})-(\\d{2})-(\\d{2})/);\n  if (!m) return String(iso || '');\n  return Number(m[3]) + ' ' + ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][Number(m[2]) - 1] + ' ' + m[1];\n}\nfunction roleName(r) {\n  return { LineManager: 'Line Manager', DeptHead: 'Department Head', CFO: 'CFO', CFOCommittee: 'CFO + Procurement Committee' }[r] || r || 'approver';\n}\nfunction listIds(ids) {\n  ids = ids || [];\n  return ids.length < 2 ? ids.join('') : ids.slice(0, -1).join(', ') + ' and ' + ids[ids.length - 1];\n}\n\nvar a = $vars.agentResult || {};\nvar rules = $vars.rules.output;\nvar tierRow = (rules.matrix || []).filter(function (t) { return t.tierId === a.requiredApprovalTier; })[0] || {};\nvar first = String(rules.requesterName || '').split(' ')[0] || 'there';\nreturn {\n  message: 'Hi ' + first + ', your requisitions ' + listIds(a.relatedPrIds || []) + ' look like parts of one purchase ('\n    + inr(a.combinedAmount) + ' together). Together they need ' + roleName(tierRow.approverRole) + ' approval (' + a.requiredApprovalTier + ').',\n  guide: 'Submit explanation: they are separate needs; say why below (project, site, purpose or budget). \"Urgent\" does not count.\\n'\n    + 'Merge my PRs: they are one purchase; combine them and send for the right approval.',\n  title: 'Please explain: ' + $vars.prId + ' may be a split purchase'\n};\n"
      }
    },
