          "source": {
            "type": "literal",
            "expression": "=response",
            "fieldType": "string"
          },
          "var": "output"
        }
      },
      "inputs": {
        "entityConfig": {
          "entityName": "SplitCase",
          "resultMode": "multiple",
          "_recordLimit": 1,
          "_filters": [
            {
              "field": "anchorPrId",
              "operator": "=",
              "value": "=js:$vars.prId"
            }
          ]
        }
      }
