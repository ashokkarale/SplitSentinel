        "label": "Manual check",
        "icon": "play"
      },
      "inputs": {
        "entryPointId": "676038c2-0102-4006-8000-666269590102",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      },
      "uniqueId": "2a8745c4-0ea0-452e-bbd8-93bc9f868bef"
    },
    {
      "id": "resolveRun",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Resolve PR",
        "icon": "code"
      },
      "inputs": {
        "script": "var id = $vars.prId || ''; var w = false; try { if ($vars.start.output.requisitionId) { id = $vars.start.output.requisitionId; w = $vars.start.output.whatIf === true; } } catch (e) {} return { prId: id, dryRun: w };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "properties": {
            "prId": {
              "type": "string"
            },
            "dryRun": {
              "type": "boolean"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "f8f41943-e19d-425c-87d6-121e0a22eafa"
    },
    {
      "id": "existingCase",
      "type": "core.datafabric.read",
      "typeVersion": "1.4",
      "display": {
        "label": "Find case",
        "icon": "layers-arrow-up-right"
      },
      "inputs": {
        "entityConfig": {
          "entityName": "SplitCase",
