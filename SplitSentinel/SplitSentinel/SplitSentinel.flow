      },
      "display": {
        "label": "Notify?",
        "icon": "trending-up-down"
      },
      "model": {
        "type": "bpmn:InclusiveGateway"
      },
      "inputs": {
        "trueLabel": "Yes",
        "falseLabel": "False",
        "expression": "!$vars.dryRun && !!$vars.rules.output.requesterEmail"
      }
    },
    {
      "id": "notifyText",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 8720,
          "y": 560
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Compose",
        "icon": "code"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output",
          "properties": {
            "to": {
              "type": "string"
            },
            "cc": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "body": {
              "type": "string"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "script": "\nvar rules = $vars.rules.output;\nvar a = $vars.agentResult || {};\nvar st = $vars.finalPrStatus;\nvar caseId = $vars.finalize.output.caseId;\nvar related = $vars.finalize.output.relatedPrIds;\nvar amount = a.combinedAmount || rules.combinedAmount;\nvar tier = a.requiredApprovalTier || rules.combinedTier;\nvar hi = 'Hi ' + rules.requesterName + ',\\n\\n';\nvar foot = '\\n\\nSplitSentinel case: ' + caseId;\nvar subject, body;\nif (st === 'Consolidated') {\n  subject = 'PRs ' + related + ' consolidated';\n  body = hi + 'Your requisitions ' + related + ' were reviewed and consolidated into one requirement of INR ' + amount\n    + '. It now goes through tier ' + tier + ' approval' + (a.competitiveBidRequired ? ' and a competitive bid (RFQ)' : '') + '.'\n    + ($vars.humanComment ? '\\n\\nComment: ' + $vars.humanComment : '') + foot;\n} else if (st === 'Rejected') {\n  subject = 'PR ' + $vars.prId + ' rejected';\n  body = hi + 'Requisition(s) ' + related + ' were rejected.' + ($vars.humanComment ? '\\n\\nComment: ' + $vars.humanComment : '') + foot;\n} else if (st === 'Unverified') {\n  subject = 'PR ' + $vars.prId + ' on hold: check could not be completed';\n  body = hi + 'SplitSentinel could not load the data needed to check PR ' + $vars.prId + ', so it is on hold. Procurement operations will re-run the check.' + foot;\n} else {\n  subject = 'PR ' + $vars.prId + ' approved for normal routing';\n  body = hi + 'Your purchase requisition ' + $vars.prId + ' passed the SplitSentinel check and continues through normal approval.'\n    + ($vars.humanDecisionValue ? '\\n\\nReviewer decision: ' + $vars.humanDecisionValue + ($vars.humanComment ? ' (' + $vars.humanComment + ')' : '') : '') + foot;\n}\nreturn { to: rules.requesterEmail, cc: (st === 'Consolidated' || st === 'Rejected') ? rules.managerEmail : '', subject: 'SplitSentinel: ' + subject, body: body };\n"
      }
    },
    {
      "id": "notify",
      "type": "uipath.connector.uipath-google-gmail.send-email",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
