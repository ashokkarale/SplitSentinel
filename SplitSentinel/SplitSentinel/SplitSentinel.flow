      "display": {
        "label": "Gmail draft",
        "icon": "https://alpha.uipath.com/311c6049-4966-4ef2-a6f3-8ceccaf38d54/studio_/typecache/icons/70091673b4573a26ec5090fa697c3bf61a0bedf4c77a302986b69d53bea30191.svg"
      },
      "model": {
        "type": "bpmn:SendTask",
        "serviceType": "Intsvc.ActivityExecution",
        "bindings": {
          "resource": "connection",
          "resourceKey": "",
          "values": [
            {
              "name": "uipath-google-gmail connection",
              "propertyAttribute": "ConnectionId"
            },
            {
              "name": "FolderKey",
              "propertyAttribute": "FolderKey"
            }
          ]
        },
        "context": [
          {
            "name": "connectorKey",
