    {
      "id": "finalize",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Prepare outcome",
        "icon": "code"
      },
      "inputs": {
        "script": "\nvar st = $vars.finalPrStatus;\nvar rules = $vars.rules.output;\nvar a = $vars.agentResult || {};\nvar related = (a.relatedPrIds && a.relatedPrIds.length) ? a.relatedPrIds : rules.groupPrIds;\nvar targets = $vars.dryRun ? [] : (st === 'Consolidated' || st === 'Rejected') ? related : [$vars.prId];\nvar log = [\n  'rules: score ' + rules.score + ' [' + rules.patterns + '] route ' + rules.route,\n  'agent: ' + (a.verdict || 'NOT_RUN') + (a.corrections ? ' (corrected: ' + a.corrections + ')' : ''),\n  'path: ' + $vars.pathValue,\n  'human: ' + ($vars.humanDecisionValue || 'none'),\n  'final: ' + st + ' -> ' + ($vars.dryRun ? 'what-if run, no PR updated' : targets.join(','))\n].join('\\n');\nreturn {\n  caseId: ($vars.dryRun ? 'WHATIF-' + $vars.prId + '-' + Date.now() : 'SC-' + $vars.prId),\n  targetRecordIds: targets.map(function (x) { return rules.recordIds[x]; }).filter(function (x) { return x; }),\n  relatedPrIds: related.join(','),\n  agentVerdict: a.verdict || 'NOT_RUN',\n  runLog: log\n};\n"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "cd4b91e8-9a43-4852-985e-629662cdf4ed"
    },
    {
