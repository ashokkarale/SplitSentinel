        "serviceType": "Actions.HITL"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": {
            "type": "literal",
            "expression": "=result",
            "fieldType": "string"
          },
          "var": "output",
          "properties": {
            "comment": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Merge PRs",
                "Keep separate",
                "Reject",
                "Not a split"
              ],
              "default": "Merge PRs"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": {
            "type": "literal",
            "expression": "=result.Action",
            "fieldType": "string"
          },
          "var": "status",
          "enum": [
            "Merge PRs",
            "Keep separate",
            "Reject",
            "Not a split"
          ],
          "default": "Merge PRs"
        }
      },
      "inputs": {
        "title": {
          "type": "jsExpression",
          "expression": "$vars.reviewCard.output.title",
          "fieldType": "string"
        },
        "priority": "High",
        "labels": "SplitSentinel,Review",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "schema": {
          "schemaId": "b6bdd2fb-fddf-5ff9-abb1-559262b1f894",
          "fields": [
            {
              "id": "whatHappened",
              "label": "What happened",
              "type": "string",
              "direction": "input",
              "binding": "vars.reviewCard.output.whatHappened",
              "controlType": "textarea"
            },
            {
              "id": "combined",
              "label": "Combined amount",
              "type": "string",
              "direction": "input",
              "binding": "vars.reviewCard.output.combined",
              "colSpan": 4
            },
            {
              "id": "approval",
              "label": "Approval needed",
              "type": "string",
              "direction": "input",
              "binding": "vars.reviewCard.output.approval",
              "colSpan": 4
            },
            {
              "id": "risk",
              "label": "Risk score",
              "type": "string",
              "direction": "input",
              "binding": "vars.reviewCard.output.risk",
              "colSpan": 4
            },
            {
              "id": "relatedPrs",
              "label": "The purchase requisitions",
              "type": "string",
              "direction": "input",
              "binding": "vars.rules.output.summary",
              "controlType": "textarea"
            },
            {
              "id": "whyFlagged",
              "label": "Why it was flagged",
              "type": "string",
              "direction": "input",
              "binding": "vars.reviewCard.output.whyFlagged",
              "controlType": "textarea"
            },
            {
              "id": "aiView",
              "label": "AI assessment",
              "type": "string",
              "direction": "input",
              "binding": "vars.reviewCard.output.aiView",
              "controlType": "textarea"
            },
            {
              "id": "justification",
              "label": "Requester's explanation",
              "type": "string",
              "direction": "input",
              "binding": "vars.reviewCard.output.justification",
              "rules": [
                {
                  "id": "hideWhenEmpty",
                  "conditions": [
                    {
                      "when": "justification",
                      "is": ""
                    }
                  ],
                  "effects": {
                    "visible": false
                  }
                }
              ],
              "controlType": "textarea"
            },
            {
              "id": "guide",
              "label": "What each button does",
              "type": "string",
              "direction": "input",
              "binding": "vars.reviewCard.output.guide",
              "controlType": "textarea"
            },
            {
              "id": "comment",
              "label": "Your comment (required; shared with the requester)",
              "type": "string",
              "direction": "output",
              "variable": "vars.comment",
              "required": true,
              "requiredMessage": "Add a short reason. It goes into the audit record and the requester's email.",
              "controlType": "textarea"
            }
          ],
          "outcomes": [
            {
              "id": "merge-prs",
              "name": "Merge PRs",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "keep-separate",
              "name": "Keep separate",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
